FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --frozen-lockfile

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_PADDLE_CLIENT_TOKEN
ARG NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_MONTHLY
ARG NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_YEARLY
ARG NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_MONTHLY
ARG NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_YEARLY
ARG NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_MONTHLY
ARG NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_YEARLY
ARG NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_MONTHLY
ARG NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_YEARLY
ENV NEXT_TELEMETRY_DISABLED=1 \
    DOCKER_BUILD=true \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=$NEXT_PUBLIC_PADDLE_CLIENT_TOKEN \
    NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_MONTHLY=$NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_MONTHLY \
    NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_YEARLY=$NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_YEARLY \
    NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_MONTHLY=$NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_MONTHLY \
    NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_YEARLY=$NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_YEARLY \
    NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_MONTHLY=$NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_MONTHLY \
    NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_YEARLY=$NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_YEARLY \
    NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_MONTHLY=$NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_MONTHLY \
    NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_YEARLY=$NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_YEARLY
RUN test -n "$NEXT_PUBLIC_PADDLE_CLIENT_TOKEN" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_MONTHLY" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_BRAND_SOLO_YEARLY" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_MONTHLY" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_STARTER_AGENCY_YEARLY" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_MONTHLY" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_PRO_AGENCY_YEARLY" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_MONTHLY" \
    && test -n "$NEXT_PUBLIC_PADDLE_PRICE_AGENCY_PLUS_YEARLY"
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME="0.0.0.0"
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1
CMD ["node", "server.js"]
