# Application
APP_NAME=PostPiloter
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=change-this-to-a-very-long-random-secret-key-at-least-64-chars

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Platform admin token expiry (shorter for security)
PLATFORM_ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=5
PLATFORM_ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=8
PLATFORM_ADMIN_RATE_LIMIT_ATTEMPTS=5
PLATFORM_ADMIN_RATE_LIMIT_WINDOW_SECONDS=600
# Comma-separated IP allowlist for platform admin (empty = all IPs allowed in dev)
PLATFORM_ADMIN_IP_ALLOWLIST=

# Platform bootstrap — used only by: python scripts/create_platform_admin.py
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_BOOTSTRAP_SECRET=change-this-before-production

# Database
DATABASE_URL=postgresql+asyncpg://flobrief:<database-password>@postgres:5432/flobrief
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://:<redis-password>@redis:6379/0
NOTIFICATION_WS_TICKET_TTL_SECONDS=60
NOTIFICATION_WS_HEARTBEAT_SECONDS=25
NOTIFICATION_WS_RECONNECT_DELAY_SECONDS=2

# Public self-service demo sandbox
# Cloudflare Turnstile keys are required when CAPTCHA is enabled in the platform panel.
DEMO_SANDBOX_TURNSTILE_SITE_KEY=
DEMO_SANDBOX_TURNSTILE_SECRET_KEY=
DEMO_SANDBOX_CLEANUP_INTERVAL_SECONDS=300

# CORS
CORS_ORIGINS=https://postpiloter.com
CORS_ALLOW_CREDENTIALS=true

# Transactional email — Resend HTTPS REST API (SMTP is not used)
# Set RESEND_API_KEY only in the server's untracked apps/backend/.env.prod file.
RESEND_API_KEY=<secret>
RESEND_TEST_MODE=False
RESEND_TEST_RECIPIENT=delivered@resend.dev
RESEND_TEST_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM=noreply@postpiloter.com
EMAIL_FROM_NAME=PostPiloter
EMAIL_REPLY_TO=

# File Storage
# Only local storage is implemented. Keep MEDIA_ROOT on a persistent volume in production.
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10

# Rate Limiting
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Frontend URL (for email links, approval portal links)
FRONTEND_URL=https://postpiloter.com

# Approval tokens
APPROVAL_TOKEN_EXPIRE_HOURS=72

# MFA / TOTP encryption key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When empty: derived from SECRET_KEY (dev only — NOT safe for production)
TOTP_ENCRYPTION_KEY=

# WhatsApp / Twilio provider (credentials stored encrypted in DB, not here)
# Global kill switch — set to true to allow WhatsApp delivery attempts
WHATSAPP_NOTIFICATIONS_ENABLED=false

# Secret encryption master key for platform provider credentials (DB field encryption)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED to save Twilio secrets via owner panel. Keep this secret — never commit.
FLOBRIEF_SECRET_ENCRYPTION_KEY=

# Public frontend URL used in WhatsApp action links
# In dev: use ngrok or Cloudflare Tunnel URL so phone can open the link
# Example: FRONTEND_PUBLIC_URL=https://abc123.ngrok.io
FRONTEND_PUBLIC_URL=https://postpiloter.com
# Exact public backend origin used in the Twilio webhook configuration
BACKEND_PUBLIC_URL=https://postpiloter.com

# Dev/staging-only allowlisted recipient for the WhatsApp test-send flow.
# Must be a number that has joined your Twilio sandbox. Never used in production.
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_DEFAULT_LOCALE=tr

# Dev-only free-text fallback when no approved Content Template exists yet.
# Only takes effect in APP_ENV=development, with the official Twilio Sandbox
# sender configured and WHATSAPP_TEST_RECIPIENT set. Never used in staging/production.
WHATSAPP_SANDBOX_FREEFORM_TEST_ENABLED=false

# iyzico Payment Gateway
# Leave empty to run in sandbox/simulated mode (no real charges)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
